Write a python code for the Naïve Bayes Classifier.

import pandas as pd
import numpy as np
from collections import Counter

data = pd.read_csv("input_file.csv")
df = pd.DataFrame(data)

spam_count = 0
not_spam_count = 0

for idx,row in df.iterrows():
    if row[5] == "Spam":
        spam_count += 1
    else:
        not_spam_count += 1

total = spam_count + not_spam_count
P_spam = spam_count / total
P_not_spam = not_spam_count / total

def get_feature_counts(df, feature, class_name):
    possible_values = df[feature].unique()
    counts = {}
    for value in possible_values:
        count = 0
        for i in range(len(df)):
            if df.loc[i, "Class"] == class_name:
                if df.loc[i, feature] == value:
                    count += 1
        counts[value] = count
    return counts

def conditional_probability(feature, value, class_name):
    counts = get_feature_counts(df, feature, class_name)
    K = len(counts)
    class_count = 0
    for i in range(len(df)):
        if df.loc[i, "Class"] == class_name:
            class_count += 1
    if value in counts:
        occurrence = counts[value]
    else:
        occurrence = 0
    probability = (occurrence + 1) / (class_count + K)

    return probability

total_records = len(df)

spam_count = 0
not_spam_count = 0

for i in range(len(df)):
    if df.loc[i, "Class"] == "Spam":
        spam_count += 1
    elif df.loc[i, "Class"] == "Not_Spam":
        not_spam_count += 1

print("Enter the email details:")
word_free = int(input("Word_Free: "))
word_win = int(input("Word_Win: "))
length = int(input("Length: "))
links = int(input("Links: "))

P_free_spam = conditional_probability("Word_Free",word_free,"Spam")
P_win_spam = conditional_probability("Word_Win",word_win,"Spam")
P_length_spam = conditional_probability("Length",length,"Spam")
P_links_spam = conditional_probability("Links",links,"Spam")

P_free_not_spam = conditional_probability("Word_Free",word_free,"Not_Spam")
P_win_not_spam = conditional_probability("Word_Win",word_win,"Not_Spam")
P_length_not_spam = conditional_probability("Length",length,"Not_Spam")
P_links_not_spam = conditional_probability("Links",links,"Not_Spam")

unnormalized_spam = (P_spam* P_free_spam* P_win_spam* P_length_spam* P_links_spam)

unnormalized_not_spam = (P_not_spam* P_free_not_spam* P_win_not_spam* P_length_not_spam* P_links_not_spam)

normalization = (unnormalized_spam +unnormalized_not_spam)
P_spam_given_X = (unnormalized_spam / normalization)
P_not_spam_given_X = (unnormalized_not_spam / normalization)

print("\n========================================")
