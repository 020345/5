Write a python code for the KNN algorithm.
import pandas as pd
import numpy as np
from collections import Counter

data = pd.read_csv("input_file.csv")
df = pd.DataFrame(data)

def knn_predict(train_df, test_point, k=3):
    distances = []

    for idx, row in train_df.iterrows():
        dist = np.sqrt((row['X'] - test_point[0])**2 + (row['Y'] - test_point[1])**2)
        distances.append((row['ID'], dist, row['Label']))
    
    distances.sort(key=lambda item: item[1])
    
    k_neighbors = distances[:k]
    
    votes = [neighbor[2] for neighbor in k_neighbors]
    majority_class = Counter(votes)

    max_votes = ""
    max_value = 0
    for key, value in majority_class.items():
      if max_value < value:
        max_value = value
        max_votes = key
    
    return max_votes, k_neighbors
  
test_point = (5.7, 2.1)

for k_val in [3, 5]:
    predicted_label, neighbors = knn_predict(df, test_point, k=k_val)
    print(f"--- K = {k_val} ---")
    print(f"Test Point: {test_point}")
    print("Nearest Neighbors:")
    for nid, d, lbl in neighbors:
        print(f"  {nid}: Distance = {d:.4f}, Label = {lbl}")
    print(f"Predicted Class: {predicted_label}\n")

