    Write a Python program to solve the given problem using the K-means Algorithm. The dataset is provided below. Consider the value of K=3.
import pandas as pd
import numpy as np
df = pd.read_csv("points.csv")
print("Dataset:")
print(df)
print()
centroids = {
    'c1': df.loc[0, ['X', 'Y']].to_numpy(dtype=float),
    'c2': df.loc[1, ['X', 'Y']].to_numpy(dtype=float),
    'c3': df.loc[2, ['X', 'Y']].to_numpy(dtype=float)
}
def euclidean_distance(point, centroid):
    diff = point - centroid
    sq_diff = diff ** 2
    distance = np.sqrt(np.sum(sq_diff))
    return float(np.round(distance, 2))
iteration = 1
while True:
    print(f"--- Iteration {iteration} ---")
    clusters = {'c1': [],'c2': [],'c3': []}
    for index, row in df.iterrows():
        point = row[['X', 'Y']].to_numpy(dtype=float)
        distances = {}
        for c_name, centroid in centroids.items():
            distance = euclidean_distance(point, centroid)
            distances[c_name] = distance
        closest_cluster = min(distances, key=distances.get)
        clusters[closest_cluster].append(index)
        print(
            f"Point {row['Point']} {point.astype(int)} "
            f"distances -> {distances} "
            f"| Assigned to: {closest_cluster}"
        )
    new_centroids = {}
    for c_name, indices in clusters.items():
        if len(indices) == 0:
            new_centroids[c_name] = centroids[c_name]
            continue
        cluster_data = df.loc[indices, ['X', 'Y']].to_numpy(dtype=float)
        avg_x = np.round(np.mean(cluster_data[:, 0]), 2)
        avg_y = np.round(np.mean(cluster_data[:, 1]), 2)
        new_centroids[c_name] = np.array([avg_x, avg_y])
    print("Updated Centroids:")
    for c_name, centroid in new_centroids.items():
        print(f"{c_name}: {centroid}")
    print()
    converged = True
    for c_name in centroids:
        if not np.array_equal(centroids[c_name],new_centroids[c_name]):
            converged = False
            break
    if converged:
        print("Centroids did not change. Algorithm converged!")
        break
    centroids = new_centroids
    iteration += 1
print("\nFinal Clusters:")
for c_name, indices in clusters.items():
    members = df.loc[indices, 'Point'].tolist()
    print(f"{c_name}: {members}")

