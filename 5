   Write a Python program to solve the given problem using the DBSCAN Algorithm. The dataset is provided below. Consider ε (epsilon) = 2 and MinPts = 2.

import pandas as pd
import numpy as np
df = pd.read_csv("points.csv")
print("Dataset:")
print(df)
eps = 2
min_pts = 2
def euclidean_distance(point1, point2):
    difference = point1 - point2
    squared_difference = difference ** 2
    distance = np.sqrt(np.sum(squared_difference))
    return np.round(distance, 4)
neighborhoods = {}
print("\n--- Neighborhoods ---")
for index, row in df.iterrows():
    point = row[['X', 'Y']].to_numpy(dtype=float)
    neighbors = []
    for other_index, other_row in df.iterrows():
        if index == other_index:
            continue
        other_point = other_row[['X', 'Y']].to_numpy(dtype=float)
        distance = euclidean_distance(point,other_point)
        if distance <= eps:
            neighbors.append(df.loc[other_index, 'Point'])
    point_name = row['Point']
    neighborhoods[point_name] = neighbors
    print(f"N({point_name}) = {neighbors}")
core_points = []
non_core = []
for point, neighbors in neighborhoods.items():
    if len(neighbors) >= min_pts:
        core_points.append(point)
    else:
        non_core.append(point)
border_points = []
outliers = []
for point in non_core:
    is_border = False
    for neighbor in neighborhoods[point]:
        if neighbor in core_points:
            is_border = True
            break
    if is_border:
        border_points.append(point)
    else:
        outliers.append(point)
print("\n--- Final Categorization ---")
print(f"Core Points: {core_points}")
print(f"Border Points: {border_points}")
print(f"Outliers: {outliers}")

