import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Step 1: Read the CSV file
data = pd.read_csv("student_marks.csv")

print("Student Marks Data:")
print(data)

# Independent variable (X)
X = data["Class_Test_Marks"].values

# Dependent variable (Y)
Y = data["Semester_Marks"].values


def main(X, Y):
    # Step 2: Calculate mean of X and Y
    mean_X = np.mean(X)
    mean_Y = np.mean(Y)

    # Step 3: Manually calculate slope (m)
    # m = Σ((X-X_mean)(Y-Y_mean)) / Σ((X-X_mean)^2)
    numerator = np.sum((X - mean_X) * (Y - mean_Y))
    denominator = np.sum((X - mean_X) ** 2)
    m = numerator / denominator

    # Step 4: Calculate intercept (c)
    c = mean_Y - (m * mean_X)

    # Step 5: Predict semester marks
    # Y = mX + c
    Y_pred = m * X + c

    result = pd.DataFrame({
        "Class_Test_Marks": X,
        "Actual_Semester_Marks": Y,
        "Predicted_Semester_Marks": Y_pred
    })

    # Step 6: Predict semester marks for Class Test = 20
    class_test_mark = 20
    predicted_mark = m * class_test_mark + c

    return (
        mean_Y,
        mean_X,
        Y_pred,
        m,
        c,
        result,
        predicted_mark,
        class_test_mark
    )


def calculate_errors(Y, Y_pred, mean_Y):
    # Step 7: Calculate MAE
    # MAE = (1/n) Σ |Y - Y_pred|
    MAE = np.mean(np.abs(Y - Y_pred))

    # Step 8: Calculate MSE
    # MSE = (1/n) Σ (Y - Y_pred)^2
    MSE = np.mean((Y - Y_pred) ** 2)

    # Step 9: Calculate RMSE
    # RMSE = sqrt(MSE)
    RMSE = np.sqrt(MSE)

    # Step 10: Calculate R-squared
    # R² = 1 - SS_res / SS_tot
    SS_res = np.sum((Y - Y_pred) ** 2)
    SS_tot = np.sum((Y - mean_Y) ** 2)
    R2 = 1 - (SS_res / SS_tot)

    # Step 11: Display evaluation metrics
    print("\nLoss Functions / Evaluation Metrics:")
    print("MAE :", MAE)
    print("MSE :", MSE)
    print("RMSE :", RMSE)
    print("R² :", R2)


# Step 12: Draw the graph
def plot_graph(m, c, predicted_mark, class_test_mark):

    plt.figure(figsize=(8, 6))

    # Actual data points
    plt.scatter(X, Y, marker='o', label='Actual Data')

    # Regression line
    # Sort X values so that the line is drawn properly
    X_line = np.linspace(min(X), max(X), 100)
    Y_line = m * X_line + c

    plt.plot(X_line, Y_line, label='Regression Line')

    # Predicted point for X = 20
    plt.scatter(
        class_test_mark,
        predicted_mark,
        marker='*',
        s=200,
        label='Prediction for X = 20'
    )

    # Draw vertical and horizontal guide lines
    plt.axvline(x=class_test_mark, linestyle='--', linewidth=1)
    plt.axhline(y=predicted_mark, linestyle='--', linewidth=1)

    # Labels and title
    plt.xlabel("Marks in Class Test")
    plt.ylabel("Marks in Semester Examination")
    plt.title("Linear Regression: Class Test Marks vs Semester Marks")

    plt.legend()
    plt.grid(True)

    # Display graph
    plt.show()


mean_Y, mean_X, Y_pred, m, c, result, predicted_mark, class_test_mark = main(X, Y)

print("\nMean of Class Test Marks:", mean_X)
print("Mean of Semester Marks:", mean_Y)

print("\nSlope (m):", m)
print("Intercept (c):", c)

print("\nActual and Predicted Semester Marks:")
print(result)

print("\nPredicted Semester Marks for Class Test = 20:")
print(predicted_mark)

calculate_errors(Y, Y_pred, mean_Y)

plot_graph(m, c, predicted_mark, class_test_mark)

