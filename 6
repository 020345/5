          Write a Python program to implement the logical AND gate using a Single Layer Perceptron (SLP) model. The perceptron should be trained using a simple learning rule until it learns the correct weights and bias that represent the AND function. Use a user-defined function to implement the  perceptron training and testing process.
import csv
import matplotlib.pyplot as plt
def step_activation(net):
    if net >= 0:
        return 1
    else:
        return 0
def load_dataset_from_csv(file_path):
    X = []
    d = []
    with open(file_path, mode='r') as file:
        csv_reader = csv.reader(file)
        next(csv_reader)  # Skip the header row
           for row in csv_reader:
            if len(row) >= 3:
                x1 = int(row[0])
                x2 = int(row[1])
                target = int(row[2])
                
                X.append([x1, x2])
                d.append(target)
    return X, d
def run_perceptron():
    # Load dataset for AND gate from the CSV file
    csv_file_path = "slp.csv"
    try:
        X, d = load_dataset_from_csv(csv_file_path)
    except FileNotFoundError:
        print(f"Error: The file '{csv_file_path}' was not found. Please create it first.")
        return
    eta = 1
    w1 = 0
    w2 = 0
    b = -1
    epoch = 1
    print("--- TRAINING PHASE ---")
    while True:
        updates_made = 0
        print("\nEpoch", epoch)
            for i in range(len(X)):
            x1 = X[i][0]
            x2 = X[i][1]
            target = d[i]
            net = (w1 * x1) + (w2 * x2) + b
            y = step_activation(net)
            e = target - y
           
            if e != 0:
                updates_made = updates_made + 1
                w1 = w1 + (eta * e * x1)
                w2 = w2 + (eta * e * x2)
                b = b + (eta * e)
           print(f"Pattern: ({x1}, {x2}) | Net: {net} | Predicted: {y} | Target: {target} | Weights: [{w1}, {w2}] | Bias: {b}")
        if updates_made == 0:
            print(f"\nPerceptron successfully converged in {epoch} epochs!")
            break
        epoch = epoch + 1
   print("\n--- TESTING PHASE ---")
    for i in range(len(X)):
        x1 = X[i][0]
        x2 = X[i][1]
        net = (w1 * x1) + (w2 * x2) + b
        y = step_activation(net)
        print(f"Input: ({x1}, {x2}) -> Predicted Output: {y}")
    print(f"\nFinal Parameters -> w1: {w1} | w2: {w2} | b: {b}")
    print("\nGenerating Decision Boundary Plot...")
    x1_class0 = [X[i][0] for i in range(len(X)) if d[i] == 0]
    x2_class0 = [X[i][1] for i in range(len(X)) if d[i] == 0]
    x1_class1 = [X[i][0] for i in range(len(X)) if d[i] == 1]
    x2_class1 = [X[i][1] for i in range(len(X)) if d[i] == 1]
   plt.figure(figsize=(6, 5))
    plt.scatter(x1_class0, x2_class0, color='red', marker='o', s=100, label='Class 0 (False)')
    plt.scatter(x1_class1, x2_class1, color='blue', marker='s', s=100, label='Class 1 (True)')

    if w2 != 0:
        # Generate x1 coordinate line limits spanning slightly past bounds
        x1_values = [-0.5, 1.5]
        x2_values = [(-w1 * x1_val - b) / w2 for x1_val in x1_values]
        plt.plot(x1_values, x2_values, color='green', linestyle='--', linewidth=2, label='Decision Boundary')
    else:
        # If w2 is zero, boundary is a vertical line: x1 = -b / w1
        if w1 != 0:
            plt.axvline(x=-b / w1, color='green', linestyle='--', linewidth=2, label='Decision Boundary')
    plt.xlim(-0.5, 1.5)
    plt.ylim(-0.5, 1.5)
    plt.xlabel('Input X1')
    plt.ylabel('Input X2')
    plt.title(f'Single Layer Perceptron - AND Gate Decision Boundary (Epochs: {epoch})')
    plt.axhline(0, color='black', linewidth=0.5, ls=':')
    plt.axvline(0, color='black', linewidth=0.5, ls=':')
    plt.grid(True, linestyle=':', alpha=0.6)
    plt.legend(loc='upper left')
    
   
    plt.savefig('perceptron_boundary.png', dpi=300)
    plt.show()
if __name__ == "__main__":
    run_perceptron()

